# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# --- AWS ---
# The S3 bucket that holds the app's JSON data files (data/*.json keys).
S3_BUCKET=your-s3-bucket-name
# boto3 also needs credentials. Provide them via the standard AWS mechanisms
# (~/.aws/credentials, an instance role, or the vars below).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# --- Flask ---
# Any long random string. Keeps login sessions valid across restarts.
FLASK_SECRET_KEY=change-me-to-a-random-string

# --- CricAPI (https://cricapi.com/) ---
# Only used by debug/call_api.py to pull finished match results.
CRICAPI_KEY=your-cricapi-key
# The CricAPI series_id for the tournament you're tracking.
CRICAPI_SERIES_ID=your-cricapi-series-id

# --- MongoDB ---
# Only used by the leftover scripts in debug/ (read_from_mg.py, write_to_db.py).
# The main web app does NOT use MongoDB.
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
